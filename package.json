{
  "name": "agent-crashtest",
  "version": "0.1.0",
  "description": "Chaos testing for AI agents: inject timeouts, duplicate deliveries, crashes, garbled results, slow tools, and rate limits between an agent and its tools, then check for double charges, lost work, and runaway retries.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "bin": {
    "crashtest": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lab": "tsx src/cli.ts lab",
    "crashtest": "tsx src/cli.ts",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "keywords": [
    "ai-agent",
    "chaos-engineering",
    "fault-injection",
    "idempotency",
    "exactly-once",
    "mcp",
    "model-context-protocol",
    "reliability",
    "testing"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trailofblocks/agent-crashtest.git"
  },
  "homepage": "https://github.com/trailofblocks/agent-crashtest#readme"
}
